{
  "id": "claude",
    "version": "0.1.0",
  "name": "Claude Code",
  "documentationURL": "http://github.com/dc-powertools/features/tree/main/src/claude",
  "description": "Installs Claude Code CLI and configures it to store state in the `dcc` session cache.",
  "options": {
    "version": {
      "default": "latest",
      "description": "Select the version to install.",
      "proposals": [
        "latest"
      ],
      "type": "string"
    }
  },
  "remoteEnv": {
    "CLAUDE_CONFIG_DIR": "${containerEnv:HOME}/.claude"
  },
  "customizations": {
    "dcc": {
      "commands": {
        "claude": "claude --continue",
        "yolo": "claude --continue --dangerously-skip-permissions"
      },
      "state": [
        "${containerEnv:HOME}/.claude"
      ]
    }
  }
}
