{
  "id": "rust",
  "version": "0.0.7",
  "name": "Rust",
  "documentationURL": "http://github.com/dc-powertools/features/tree/main/src/rust",
  "description": "Installs the Rust toolchain via rustup, including rustfmt and clippy.",
  "options": {
    "version": {
      "default": "stable",
      "description": "Toolchain version to install ('stable', 'nightly', or a specific version like '1.85.0').",
      "proposals": [
        "stable",
        "nightly"
      ],
      "type": "string"
    },
    "fmt": {
      "default": "true",
      "description": "Install rustfmt.",
      "type": "boolean"
    },
    "clippy": {
      "default": "true",
      "description": "Install clippy.",
      "type": "boolean"
    },
    "gcc": {
      "default": "true",
      "description": "Install gcc (required by crates that compile C code).",
      "type": "boolean"
    }
  },
  "remoteEnv": {
    "RUSTUP_HOME": "${containerEnv:HOME}/.rustup",
    "CARGO_HOME": "${containerEnv:HOME}/.cargo",
    "PATH": "${containerEnv:HOME}/.cargo/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "dcc": {
      "state": [
        "${containerEnv:HOME}/.rustup",
        "${containerEnv:HOME}/.cargo",
        "${containerWorkspaceFolder}/target"
      ]
    }
  }
}
