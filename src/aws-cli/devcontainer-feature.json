{
  "id": "aws-cli",
  "version": "0.0.6",
  "name": "AWS CLI",
  "documentationURL": "http://github.com/dc-powertools/features/tree/main/src/aws-cli",
  "description": "Installs the AWS CLI v2 with SSO configuration support.",
  "options": {
    "ssoStartUrl": {
      "default": "",
      "description": "AWS SSO start URL (e.g., https://my-portal.awsapps.com/start).",
      "type": "string"
    },
    "ssoRegion": {
      "default": "",
      "description": "AWS region for SSO (e.g., us-east-1).",
      "type": "string"
    },
    "ssoAccountId": {
      "default": "",
      "description": "AWS account ID for SSO (e.g., 123456789012).",
      "type": "string"
    },
    "ssoRoleName": {
      "default": "",
      "description": "AWS IAM role name for SSO (e.g., ReadOnly, PowerUserAccess).",
      "type": "string"
    },
    "region": {
      "default": "",
      "description": "Default AWS region for CLI commands (e.g., us-west-2). Defaults to ssoRegion if not set.",
      "type": "string"
    }
  },
  "mounts": [
    {
      "source": "${localCacheFolder}/.aws",
      "target": "${containerEnv:HOME}/.aws",
      "type": "bind"
    }
  ],
  "onCreateCommand": "/usr/local/share/aws-cli/onCreate.sh",
  "command": "aws",
  "scripts": {
    "sso-configure": "aws configure sso --use-device-code --profile default",
    "sso-login": "aws sso login --use-device-code --profile default"
  }
}
