{
  "id": "codex",
  "version": "0.2.0",
  "name": "OpenAI Codex",
  "documentationURL": "http://github.com/dc-powertools/features/tree/main/src/codex",
  "description": "Installs OpenAI Codex CLI with image-controlled executable packages and persistent user state. Requires dcc 0.4.0 or newer.",
  "options": {
    "version": {
      "default": "latest",
      "description": "Select the version to install.",
      "proposals": [
        "latest"
      ],
      "type": "string"
    }
  },
  "remoteEnv": {
    "CODEX_HOME": "${containerEnv:HOME}/.codex"
  },
  "customizations": {
    "dcc": {
      "commands": {
        "codex": "codex resume",
        "yolo": "codex resume --yolo"
      },
      "state": [
        {
          "path": "${containerEnv:HOME}/.codex",
          "type": "directory-with-exclusions",
          "exclude": [
            {
              "path": "packages",
              "target": "/opt/dcc-local/codex/packages"
            },
            {
              "path": "tmp",
              "target": "/opt/dcc-local/codex/tmp"
            }
          ]
        }
      ]
    }
  }
}
