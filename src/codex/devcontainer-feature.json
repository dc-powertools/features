{
  "id": "codex",
    "version": "0.1.0",
  "name": "OpenAI Codex",
  "documentationURL": "http://github.com/dc-powertools/features/tree/main/src/codex",
  "description": "Installs OpenAI Codex CLI and configures it to store state in the `dcc` session cache.",
  "options": {
    "version": {
      "default": "latest",
      "description": "Select the version to install.",
      "proposals": [
        "latest"
      ],
      "type": "string"
    }
  },
  "remoteEnv": {
    "CODEX_HOME": "${containerEnv:HOME}/.codex"
  },
  "customizations": {
    "dcc": {
      "commands": {
        "codex": "codex resume",
        "yolo": "codex resume --yolo"
      },
      "state": [
        "${containerEnv:HOME}/.codex"
      ]
    }
  }
}
